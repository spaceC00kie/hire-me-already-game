{
  "firestore": {
    "target": "hire-me-already-game",
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "hire-me-already-game",
      "predeploy": "yarn build",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
